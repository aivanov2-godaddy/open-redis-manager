[Unit]
Description=Open Redis Manager cache instance for %i
After=local-fs.target
Wants=orm-metrics-collect@%i.timer
ConditionPathIsDirectory=/var/lib/orm-instances/%i
ConditionPathExists=/etc/orm-instances/%i/manifest.json
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=%i
Group=%i
ExecStart=/usr/local/cpanel/3rdparty/orm/bin/orm-instance-launcher %i
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=10s
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=true
MemoryMax=96M
CPUQuota=20%
TasksMax=32
LimitNOFILE=256
ReadOnlyPaths=/etc/orm-instances/%i
ReadWritePaths=/var/lib/orm-instances/%i
UMask=0077

[Install]
WantedBy=multi-user.target
